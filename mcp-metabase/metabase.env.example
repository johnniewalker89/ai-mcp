# Этот файл — справочный шаблон. mcp-metabase не загружает dotenv автоматически;
# передай значения через конфиг MCP-клиента или системное окружение.
METABASE_MCP_INSTANCE=metabase_work
METABASE_BASE_URL=https://metabase.example.org
METABASE_API_KEY=<metabase-api-key>
# Дополнительная жёсткая identity binding.
# METABASE_MCP_EXPECTED_USER_ID=123

METABASE_MCP_SUPPORTED_VERSION_PREFIXES=v0.63.,0.63.
METABASE_MCP_DEFAULT_QUERY_ROWS=100
METABASE_MCP_MAX_QUERY_ROWS=200
METABASE_MCP_MAX_JSON_BYTES=4000000
METABASE_MCP_MAX_QUERY_BYTES=4000000
METABASE_MCP_MAX_LIST_ITEMS=200
METABASE_MCP_MAX_BATCH_ITEMS=50
METABASE_MCP_PLAN_TTL_SECONDS=300
METABASE_MCP_MAX_ACTIVE_PLANS=100
METABASE_MCP_MAX_PLAN_BYTES=8000000
METABASE_MCP_EDIT_SESSION_TTL_SECONDS=900
METABASE_MCP_EDIT_SESSION_MAX_ACTIONS=20
METABASE_MCP_MAX_ACTIVE_EDIT_SESSIONS=20
METABASE_MCP_REQUEST_TIMEOUT_SECONDS=30
METABASE_MCP_READ_ATTEMPTS=2

METABASE_MCP_AUDIT_DIR=<absolute-local-audit-directory>
METABASE_MCP_SOURCE_REVISION=<40-character-git-sha>

# Разрешай HTTP только для локального тестового origin.
METABASE_MCP_ALLOW_HTTP_LOCALHOST=false
